# Copia este archivo como .env y completa los valores

# --- Ejecutar el backend en tu máquina (./mvnw spring-boot:run) ---
DB_URL=jdbc:mysql://localhost:3306/gym_jf?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
# Genera una clave con: openssl rand -base64 32
JWT_SECRET=

# --- Docker (docker compose up -d --build) ---
# El compose usa JWT_SECRET de arriba, pero define su propia BD (ignora DB_URL/DB_PASSWORD).
# Contraseña del root del MySQL del contenedor (por defecto: gymjf_dev)
# DOCKER_DB_PASSWORD=gymjf_dev
# Puerto del host para conectar Workbench al contenedor (por defecto: 3307)
# DB_HOST_PORT=3307
