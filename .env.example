# Copia este archivo como .env y completa los valores

# --- Ejecutar el backend en tu máquina (./mvnw spring-boot:run) ---
DB_URL=jdbc:mysql://localhost:3306/gym_jf?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
# Genera una clave con: openssl rand -base64 32
JWT_SECRET=

# --- Docker (docker compose up -d --build) ---
# El compose usa JWT_SECRET de arriba, pero define su propia BD (ignora DB_URL/DB_PASSWORD).
# Contraseña del root del MySQL del contenedor (por defecto: gymjf_dev)
# DOCKER_DB_PASSWORD=gymjf_dev
# Puerto del host para conectar Workbench al contenedor (por defecto: 3307)
# DB_HOST_PORT=3307
# Perfil de Spring: dev (predeterminado, Swagger abierto y SQL en el log) o prod
# SPRING_PROFILES_ACTIVE=dev
# Orígenes web permitidos por CORS, separados por comas (vacío = ninguno; en dev ya permite localhost)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Primer administrador (se crea al arrancar solo si no existe ningún ADMIN) ---
# BOOTSTRAP_ADMIN_EMAIL=admin@tugimnasio.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrador Gym JF

# --- Correo de recuperación de contraseña (proveedor: Brevo, por SMTP) ---
# MAIL_ENABLED=false significa correo simulado (en dev se imprime en el log). En producción: true.
# MAIL_ENABLED=false
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=      (el "login SMTP" que muestra Brevo)
# MAIL_PASSWORD=      (la clave SMTP generada en Brevo)
# MAIL_FROM=          (remitente verificado en Brevo)
# FRONTEND_RESET_URL=http://localhost:3000/restablecer-contrasena
