# Fuerza utf8mb4 también en el cliente `mysql` que usa la imagen para ejecutar los scripts de
# docker-entrypoint-initdb.d. Sin esto lee los acentos como latin1 y los mensajes de los
# triggers y procedimientos quedan doble codificados ("mÃ¡ximo").
[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
